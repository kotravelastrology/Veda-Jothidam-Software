# Frontend Dockerfile - Vanilla JavaScript with http-server
FROM node:18-alpine

WORKDIR /app

# Install http-server globally
RUN npm install -g http-server && npm cache clean --force

# Copy frontend source code
COPY frontend/ .

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001 && chown -R nodejs:nodejs /app

USER nodejs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:3000 || exit 1

CMD ["http-server", ".", "-p", "3000", "-c-1", "--gzip"]

# ============ BUILD INSTRUCTIONS ============
# Build:
#   docker build -f Dockerfile.frontend -t veda-jothidam-frontend:latest .
#
# Run:
#   docker run -p 3000:3000 veda-jothidam-frontend:latest
#
# Tag for registry:
#   docker tag veda-jothidam-frontend:latest myregistry.azurecr.io/veda-jothidam-frontend:latest
#
# Push:
#   docker push myregistry.azurecr.io/veda-jothidam-frontend:latest
