# The web app: the Next.js program (app/, src/). It replaced the old static HTML app (frontend/, removed on 2026-10-31), which this
# file used to serve. Node 24: the chart library uses the built-in node:sqlite; @swisseph/node ships a linux-x64 prebuild.

# ============ BUILD STAGE ============
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# ============ RUNTIME STAGE ============
FROM node:24-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    VEDA_LIBRARY_PATH=/data/library.db
COPY --from=build /app ./
# The saved charts live in /data (mount a volume there so they survive a new image)
RUN mkdir -p /data && chown -R node:node /data
USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD node -e "fetch('http://localhost:3000/').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["npm", "start"]

# ============ BUILD INSTRUCTIONS ============
# Build:  docker build -f Dockerfile.frontend -t veda-jothidam-web:latest .
# Run:    docker run -p 3000:3000 -v veda_library:/data veda-jothidam-web:latest
