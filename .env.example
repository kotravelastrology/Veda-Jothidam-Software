# Veda Jothidam Environment Configuration
# Copy this file to .env and fill in your values

# =====================================================
# DATABASE CONFIGURATION
# =====================================================

# PostgreSQL Connection URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://vedic_user:your_password@localhost:5432/vedic_astrology

# Database settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vedic_astrology
DB_USER=vedic_user
DB_PASSWORD=your_secure_password_here

# =====================================================
# FLASK CONFIGURATION
# =====================================================

# Environment: development, testing, production
FLASK_ENV=development

# Flask debug mode
FLASK_DEBUG=True

# Server host and port
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# =====================================================
# JWT & SECURITY
# =====================================================

# JWT Secret Key (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=your-secret-key-change-this-in-production

# JWT Token expiration times (in seconds)
JWT_ACCESS_TOKEN_EXPIRES=900  # 15 minutes
JWT_REFRESH_TOKEN_EXPIRES=604800  # 7 days

# =====================================================
# CORS CONFIGURATION
# =====================================================

# Allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000

# =====================================================
# LOGGING
# =====================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/vedic_astrology.log

# =====================================================
# FRONTEND CONFIGURATION
# =====================================================

# Next.js API URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Frontend port
NEXT_PUBLIC_PORT=3000

# =====================================================
# EMAIL CONFIGURATION (Optional)
# =====================================================

# SMTP settings for sending emails
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@vedic-astrology.com

# =====================================================
# PAYMENT CONFIGURATION (Phase 3)
# =====================================================

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Stripe (alternative)
STRIPE_PUBLIC_KEY=your-stripe-public-key
STRIPE_SECRET_KEY=your-stripe-secret-key

# =====================================================
# ASTROLOGY SETTINGS
# =====================================================

# Default Ayanamsa (lahiri, raman, kp, true_citra)
DEFAULT_AYANAMSA=lahiri

# Default timezone
DEFAULT_TIMEZONE=Asia/Kolkata

# Default node type (mean, true)
DEFAULT_NODE_TYPE=mean

# =====================================================
# FEATURE FLAGS
# =====================================================

# Enable/Disable features
ENABLE_REGISTRATION=true
ENABLE_CONSULTATIONS=true
ENABLE_PAYMENTS=false  # Enable in production
ENABLE_API_DOCS=true
ENABLE_DEBUG_TOOLBAR=false  # Only in development

# =====================================================
# MONITORING & ANALYTICS (Optional)
# =====================================================

# Sentry (Error tracking)
SENTRY_DSN=

# Google Analytics
GOOGLE_ANALYTICS_ID=

# =====================================================
# DEPLOYMENT (Production Only)
# =====================================================

# Production domain
PRODUCTION_DOMAIN=vedic-astrology.com
PRODUCTION_URL=https://vedic-astrology.com

# SSL/TLS
SSL_CERTIFICATE_PATH=/etc/ssl/certs/vedic-astrology.crt
SSL_PRIVATE_KEY_PATH=/etc/ssl/private/vedic-astrology.key

# =====================================================
# NOTES
# =====================================================
# 1. NEVER commit the .env file to git (it contains secrets)
# 2. Always use strong passwords (12+ chars with special characters)
# 3. Generate JWT_SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 4. For development, you can use simple values
# 5. For production, use environment-specific configuration
# 6. Keep .env.example updated with new variables
