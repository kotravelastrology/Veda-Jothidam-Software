{
  "000": "இயல்புநிலை நிகழ்வு",
  "001": "அறுவைச் சிகிச்சை",
  "002": "அரசியல் வாழ்க்கை",
  "003": "சித்தி தீட்சை பெறுதல்",
  "004": "ஜோதிட இணையதளம் தொடங்குதல்",
  "005": "வெளிநாட்டில் குடியேறுதல்",
  "006": "வங்கிக் கணக்கு தொடங்குதல்",
  "007": "தனித் தொழில் தொடங்குதல்",
  "008": "இரண்டாம் திருமணம்",
  "009": "தொலைந்த சொத்தை மீட்க புகார் அளித்தல்",
  "010": "வேலைக்காக வெளிநாடு செல்லுதல்",
  "011": "இளைய உடன்பிறந்தோருடன் உறவை மேம்படுத்த பேசுதல்",
  "012": "குழந்தைத் தத்தெடுப்பு குறித்து பேசுதல்",
  "013": "லாட்டரி வாங்குதல்",
  "014": "தரகர் தொழில் தொடங்குதல்",
  "015": "நேர்முகத் தேர்வு",
  "016": "புத்தகம் வெளியிடுதல்",
  "017": "செய்தித்தாள் தொடங்குதல்",
  "018": "ஒப்பந்தத்தில் கையெழுத்திடுதல்",
  "019": "தொலைக்காட்சி அல்லது மின்சாதனங்கள் வாங்குதல்",
  "020": "நீதிமன்ற மேல்முறையீடு தொடங்குதல்",
  "021": "திருமணத்திற்காக மணமகன் மணமகள் முதல் சந்திப்பு",
  "022": "பள்ளியில் சேருதல்",
  "023": "கல்லூரியில் சேருதல்",
  "024": "உயர்கல்வி - முனைவர் பட்டம், ஐஏஎஸ்",
  "025": "நிலம் வாங்குதல் அல்லது வீடு கட்டுதல்",
  "026": "சொத்தை வாடகைக்கு விடுதல்",
  "027": "வாகனம் வாங்குதல்",
  "028": "குளிர்சாதனப் பெட்டி வாங்குதல்",
  "029": "குழந்தைப் பேறுக்கான தாம்பத்திய உறவு",
  "030": "மணமகன் அல்லது மணமகளுக்கு திருமண முன்மொழிவு",
  "031": "கூட்டுத் தொழில்",
  "032": "பங்குச் சந்தையில் ஊக லாபம்",
  "033": "சூதாட்டம் அல்லது பந்தயம்",
  "034": "திரைப்பட நடிகராக அறிமுகமாகுதல்",
  "035": "உபநயன சடங்கு",
  "036": "தொழில்முறை ஜோதிடராகப் பணியைத் தொடங்குதல்",
  "037": "தொழில்முறை ஜோதிடராகப் பணியைத் தொடங்குதல்",
  "038": "மது, போதை அல்லது புகைப் பழக்க சிகிச்சை தொடங்குதல்",
  "039": "வேலையில் சேருதல்",
  "040": "வேலையில் சேருதல்",
  "041": "வங்கி ஓவர் டிராஃப்ட் அல்லது கடனுக்கு விண்ணப்பித்தல்",
  "042": "தேர்தல், வழக்கு அல்லது விளையாட்டு",
  "043": "வாடகையாளரைப் பெற விளம்பரம் செய்தல்",
  "044": "குழந்தையைத் தத்தெடுத்தல்",
  "045": "திருமணத்திற்காக வெளிநாடு செல்லுதல்",
  "046": "திருமணம் அல்லது துணையுடன் மீண்டும் இணைதல்",
  "047": "வணிகக் கூட்டாண்மை",
  "048": "பணிக்கொடை, காப்பீடு அல்லது உயிலுக்கு விண்ணப்பித்தல்",
  "049": "நண்பரிடம் நிதி உதவி கேட்பது",
  "050": "உயர்கல்விக்காக வெளிநாடு செல்லுதல்",
  "051": "முதுநிலை அல்லது உயர்கல்வி",
  "052": "வெளிநாடு செல்லுதல்",
  "053": "புனித யாத்திரை தொடங்குதல்",
  "054": "இரண்டாம் திருமணம்",
  "055": "ஆன்மிக வாழ்க்கை மற்றும் இறை வழிபாடு தொடங்குதல்",
  "056": "அரசியலில் புகழ் அல்லது வெற்றி",
  "057": "ஆராய்ச்சிக் குழு அல்லது இணைய ஆராய்ச்சிக் குழு தொடங்குதல்",
  "058": "பெரிய பரம்பரைச் சொத்தைப் பொறுப்பேற்றல்",
  "059": "வணிகத்திற்காக வெளிநாடு செல்லுதல்",
  "060": "புதிய தொழில் தொடங்குதல்",
  "061": "அரசியலில் புகழ் அல்லது வெற்றி",
  "062": "வேலையில் சேருதல்",
  "063": "பதவி உயர்வு பெறுதல்",
  "064": "விருது அல்லது பரிசுக்கு விண்ணப்பித்தல்",
  "065": "தனித் தொழில் தொடங்குதல்",
  "066": "பங்குச் சந்தை தொழில் தொடங்குதல்",
  "067": "புதிய பொருளை வெளியிடுதல்",
  "068": "கிரீன் கார்டுக்கு விண்ணப்பித்தல்",
  "069": "திருமண விளம்பரம்",
  "070": "தொழிற்சாலை திறப்பு",
  "071": "வெளிநாட்டிற்கு குடிபெயர்தல்",
  "072": "தாய்நாட்டிற்கு நிரந்தரமாகத் திரும்புதல்",
  "073": "திருமணத்திற்காக வெளிநாடு செல்லுதல்",
  "074": "சந்நியாசம் மேற்கொள்ளுதல்",
  "075": "ஆலயம் அல்லது மதக் கட்டிடம் கட்டுதல்",
  "076": "காவல்துறையிடம் சரணடைதல்",
  "077": "ஜாமீனில் விடுதலையான பின் திரும்புதல்",
  "078": "விண்வெளி ஓடம் ஏவுதல்",
  "079": "வேலை விண்ணப்பத்தில் கையெழுத்திட்டு அனுப்புதல்"
}
