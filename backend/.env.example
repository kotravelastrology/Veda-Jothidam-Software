# Backend Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit the actual .env file to version control!

# ============================================
# ENVIRONMENT
# ============================================
FLASK_ENV=development
# Options: development, testing, production

# ============================================
# DATABASE
# ============================================
DATABASE_URL=sqlite:///app.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/vedic_astrology

# ============================================
# JWT & SECURITY
# ============================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-this-in-production

# Token expiration (in minutes and days)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CORS & ORIGINS
# ============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Comma-separated list of allowed methods
CORS_MAX_AGE=3600
CORS_ALLOW_CREDENTIALS=true

# ============================================
# RATE LIMITING
# ============================================
# Redis URL for rate limiting (optional)
# REDIS_URL=redis://localhost:6379

# Rate limit definitions
# Format: "count/period" where period is second, minute, hour, day
# Examples: "10/second", "100/minute", "1000/hour"
RATELIMIT_LOGIN=5/15min
RATELIMIT_SIGNUP=3/hour
RATELIMIT_CHART_CREATE=10/hour
RATELIMIT_UPLOAD=5/hour

# ============================================
# PASSWORD POLICY
# ============================================
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_EXPIRY_DAYS=90
PASSWORD_HISTORY_COUNT=5

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json
# Options: json, text
LOG_FILE=backend/logs/app.log

# ============================================
# EMAIL (Optional - for notifications)
# ============================================
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_ADDRESS=noreply@vedic-astrology.com

# ============================================
# OPTIONAL SERVICES
# ============================================
# Sentry (Error tracking)
# SENTRY_DSN=https://your-sentry-url

# New Relic (Performance monitoring)
# NEW_RELIC_LICENSE_KEY=your-key
# NEW_RELIC_APP_NAME=vedic-astrology-api

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_RATE_LIMITING=true
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_TRACKING=false
ENABLE_2FA=false

# ============================================
# DEBUG & DEVELOPMENT
# ============================================
DEBUG=false
# Set to true only for development!
TESTING=false
