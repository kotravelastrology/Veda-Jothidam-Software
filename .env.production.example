# Veda Jothidam - Production Environment Configuration
#
# IMPORTANT: This is a template file. Copy to .env.production and update values
# NEVER commit actual secrets to version control
# Use secure methods to manage secrets (AWS Secrets Manager, HashiCorp Vault, etc.)
#
# Date: 2026-09-15
# Environment: Production
# Status: Template - Requires manual configuration

# ============================================================================
# FLASK APPLICATION CONFIGURATION
# ============================================================================

# Flask environment - MUST be 'production' for live deployment
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_APP=wsgi:app

# Server configuration
SERVER_NAME=yourdomain.com
PREFERRED_URL_SCHEME=https

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Use managed database service (AWS RDS, Google Cloud SQL, DigitalOcean, etc.)
# DO NOT use SQLite in production!

# Production PostgreSQL Connection
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://prod_user:CHANGE_ME_STRONG_PASSWORD@prod-db.example.com:5432/veda_jothidam_prod

# Alternative database credentials (if not using full URL)
DB_HOST=prod-db.example.com
DB_PORT=5432
DB_NAME=veda_jothidam_prod
DB_USER=prod_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Database SSL configuration (for managed services)
DB_SSL_MODE=require
DB_SSL_CERT_PATH=/etc/ssl/certs/ca-certificates.crt

# Connection pooling
DATABASE_POOL_SIZE=20
DATABASE_POOL_RECYCLE=3600
DATABASE_POOL_PRE_PING=True

# ============================================================================
# REDIS CACHE CONFIGURATION
# ============================================================================

# Production Redis Connection
# Use managed Redis service for high availability
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis.example.com:6379/0

# Alternative Redis configuration
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_SSL=True

# Cache configuration
CACHE_DEFAULT_TIMEOUT=300
CACHE_TYPE=redis

# ============================================================================
# JWT AUTHENTICATION CONFIGURATION
# ============================================================================

# JWT Secret Key - MUST be cryptographically secure random string
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# MINIMUM 64 characters
JWT_SECRET_KEY=CHANGE_ME_GENERATE_STRONG_SECRET_KEY_MIN_64_CHARS_CRYPTOGRAPHICALLY_SECURE

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Token blacklist (revoked tokens)
JWT_TOKEN_LOCATION=headers
JWT_HEADER_NAME=Authorization
JWT_HEADER_TYPE=Bearer

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed origins - MUST be your actual domain
# Comma-separated for multiple domains
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# CORS detailed configuration
CORS_ALLOW_HEADERS=Content-Type,Authorization,Accept,X-Requested-With
CORS_EXPOSE_HEADERS=Content-Type,Content-Length,X-Total-Count
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_CREDENTIALS=True
CORS_MAX_AGE=3600

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# HTTPS/SSL Configuration
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Strict

# Security headers
SECURITY_HEADERS_ENABLED=True
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=True
HSTS_PRELOAD=True

# Content Security Policy
CSP_ENABLED=True
CSP_DEFAULT_SRC=self
CSP_SCRIPT_SRC=self
CSP_STYLE_SRC=self
CSP_IMG_SRC=self,data:,https:
CSP_FONT_SRC=self

# ============================================================================
# APPLICATION URLs
# ============================================================================

# Frontend URL - Where the frontend is hosted
FRONTEND_URL=https://yourdomain.com

# Backend API URL - For CORS and frontend API calls
BACKEND_URL=https://yourdomain.com/api

# Application base URL
APP_URL=https://yourdomain.com

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
# For user notifications, password resets, consultation confirmations

# SMTP Server Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Alternative: Use transactional email service
# SMTP_SERVER=smtp.sendgrid.net
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=SG.xxxxx

# Email settings
SMTP_USE_TLS=True
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME="Veda Jothidam"

# Email templates location
EMAIL_TEMPLATE_PATH=/app/email_templates

# ============================================================================
# ENVIRONMENT SETTINGS
# ============================================================================

ENVIRONMENT=production
DEBUG=False
TESTING=False

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file location (for file-based logging)
LOG_FILE_PATH=/var/log/veda-jothidam/app.log
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_BACKUP_COUNT=10

# Log format
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Structured logging (JSON format for log aggregation)
LOG_FORMAT_JSON=True

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Application Performance Monitoring (APM)
# For services like Datadog, New Relic, etc.
APM_ENABLED=True
APM_SERVICE_NAME=veda-jothidam-api
APM_ENVIRONMENT=production
APM_VERSION=1.0.0

# Error tracking (Sentry)
SENTRY_DSN=

# Metrics collection
METRICS_ENABLED=True
METRICS_PORT=9090

# Health check endpoint
HEALTH_CHECK_ENABLED=True

# ============================================================================
# RATE LIMITING
# ============================================================================

# Rate limits per endpoint (requests per hour)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_SIGNUP=3
RATE_LIMIT_CHART_CREATE=10
RATE_LIMIT_API_GENERAL=100

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================

# Database backup settings
BACKUP_ENABLED=True
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30

# Backup location (S3, Azure Blob, etc.)
BACKUP_STORAGE=s3
BACKUP_S3_BUCKET=veda-jothidam-backups
BACKUP_S3_REGION=us-east-1

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Gunicorn worker settings
GUNICORN_WORKERS=4
GUNICORN_WORKER_CLASS=gthread
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
GUNICORN_KEEP_ALIVE=2

# Database connection pooling
DB_POOL_SIZE=20
DB_POOL_RECYCLE=3600

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================

# Payment processing (if needed)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# SMS notifications (if needed)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Feature toggles for gradual rollout
FEATURE_CONSULTATIONS=True
FEATURE_PDF_EXPORT=True
FEATURE_EMAIL_NOTIFICATIONS=True
FEATURE_ADVANCED_ANALYTICS=False

# ============================================================================
# NOTES FOR DEPLOYMENT TEAM
# ============================================================================
#
# 1. GENERATE STRONG SECRETS
#    - JWT_SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(64))"
#    - DB_PASSWORD: Use strong, random password (min 24 chars)
#    - REDIS_PASSWORD: Use strong, random password (min 24 chars)
#
# 2. DATABASE SETUP
#    - Use managed PostgreSQL service (RDS, Cloud SQL, etc.)
#    - Enable SSL/TLS encryption
#    - Set up automated backups
#    - Configure connection pooling
#
# 3. SECURITY
#    - Enable HTTPS with valid SSL certificate
#    - Configure firewall rules
#    - Set up WAF (Web Application Firewall)
#    - Enable database encryption at rest
#
# 4. MONITORING
#    - Setup error tracking (Sentry, DataDog)
#    - Configure log aggregation (CloudWatch, ELK)
#    - Set up alerting for critical errors
#    - Monitor database performance
#
# 5. DEPLOYMENT
#    - Use CI/CD pipeline (GitHub Actions, GitLab CI)
#    - Automate testing before deployment
#    - Use blue-green or canary deployment
#    - Keep rollback plan ready
#
# 6. SCALING
#    - Use load balancer for multiple instances
#    - Configure auto-scaling based on CPU/memory
#    - Use separate read replicas for database
#    - Cache frequently accessed data in Redis
#
